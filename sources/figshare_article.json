ame": "_", "orcid_id": ""}, {"id": 20329115, "full_name": "Hartmut St\u00fctzel", "first_name": "Hartmut", "last_name": "St\u00fctzel", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20329117, "full_name": "Benjamin Wittkop", "first_name": "Benjamin", "last_name": "Wittkop", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20329118, "full_name": "Tsu-Wei Chen", "first_name": "Tsu-Wei", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-6698-563X"}], "custom_fields": [{"name": "Research Data Support", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Complete where RDS data are part of RDS submission"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Manuscript #", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Manuscript Identifier from eJP"}, "field_type": "text", "order": null, "is_mandatory": false}], "figshare_url": "https://springernature.figshare.com/articles/dataset/Multi-environment_field_trials_for_wheat_yield_stability_and_breeding_progress_in_Germany/27910269", "download_disabled": false, "description": "Multi-environmental trials (MET) with temporal and spatial variance are crucial for understanding genotype-environment-management (GxExM) interactions in crops. Here, we present a MET dataset for winter wheat in Germany. The dataset encompasses MET spanning six years (2015 - 2020), six locations and nine crop management scenarios (consisting of combinations for three treatments, unbalanced in each location and year) comparing 228 cultivars released between 1963 and 2016, amounting to a total of 526,751 data points covering 24 traits. Beside grain yield, ten agronomic traits, four baking quality traits, plant height, heading date, maturity date and six fungal disease infection indices are included. Additionally, we provide management records, including fertilizer use, plant protection measures, irrigation, and weather data. We demonstrate how this dataset can address four agronomic questions related to GxExM interactions. Further potential applications of the dataset include empirical analyses, genomic and enviromic analyses for breeding targets, or development of decision-supporting models for agricultural management and policy decisions.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 11329195, "created_date": "2025-01-15T08:04:23Z", "modified_date": "2025-01-15T08:04:23Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["winter wheat (Triticum aestivum L.)", "multi-environment trials Breeding", "agronomic field trials", "Yield stability", "breeding progress", "Plant breeding.", "yield component analysis"], "keywords": ["winter wheat (Triticum aestivum L.)", "multi-environment trials Breeding", "agronomic field trials", "Yield stability", "breeding progress", "Plant breeding.", "yield component analysis"], "categories": [{"id": 1293, "title": "Agronomy", "parent_id": 1274, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 1296, "title": "Crop and Pasture Improvement (Selection and Breeding)", "parent_id": 1274, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1038/s41597-024-04332-7"], "has_linked_file": false, "citation": "Wang, Tien-Cheng; Rose, Till; Zetzsche, Holger; Ballvora, Agim; Friedt, Wolfgang; Kage, Henning; et al. (2025). Multi-environment field trials for wheat yield, stability and breeding progress in Germany. figshare. Dataset. https://doi.org/10.6084/m9.figshare.27910269.v1", "related_materials": [{"id": 212914337, "identifier": "10.1038/s41597-024-04332-7", "title": "Multi-environment field trials for wheat yield, stability and breeding progress in Germany", "relation": "IsSup